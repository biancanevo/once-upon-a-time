# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_PORT=5000
SECRET_KEY=your-secret-key-change-in-production

# Ollama Configuration
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:1b
OLLAMA_TIMEOUT=120

# TTS Configuration
# Options: edge, pyttsx3, google
TTS_PROVIDER=pyttsx3
EDGE_TTS_VOICE=es-ES-PabloNeural
GOOGLE_API_KEY=your-google-api-key-here

# Audio Configuration
AUDIO_CACHE_DIR=./audio_cache
MAX_CACHE_SIZE_MB=500

# Speech Recognition
SPEECH_LANGUAGE=es-ES
SPEECH_TIMEOUT=5

# Hardware Configuration
# Set to True for local development without physical hardware
MOCK_HARDWARE=True
MOCK_OLLAMA=False

# LED Configuration
LED_COUNT=12
LED_PIN=18
LED_BRIGHTNESS=0.5

# RFID Configuration
RFID_DEBOUNCE_TIME=1.5

# Logging
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
